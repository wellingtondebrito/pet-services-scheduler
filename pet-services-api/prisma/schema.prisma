// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum StatusUser {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserRole{
  PET_OWNER
  PET_PROVIDER
  ADMIN
  EMPLOYEE
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  role UserRole @default(PET_OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status StatusUser @default(ACTIVE)

  petOnerProfile PetOwner?
  providerProfile PetProvider?
  adminProfile Admin?
  employeeProfile Employee?
}

model Admin {
  id Int @id @default(autoincrement())
  name String
  avatarUrl String?
  userId Int @unique
  user User @relation(fields: [userId], references: [id])  
}

model PetOwner {
  id Int @id @default(autoincrement())
  name String
  phoneNumber String
  address String
  city String
  uf String
  cep String
  cpf String?
  avatarUrl String?
  userId Int @unique
  user User @relation(fields: [userId], references: [id])

  appointments Appointment[]
  reviews Review[]
  favoritesProviders PetProvider[] @relation("FavoriteProviders")
  signatures Signatures[]
  pets Pet[]
  
}

model Employee {
  id Int @id @default(autoincrement())
  name String
  avatarUrl String?
  userId Int @unique
  user User @relation(fields: [userId], references: [id])
  petProviderId Int
  petProvider PetProvider @relation(fields: [petProviderId], references: [id])
}

model PetProvider {
  id Int @id @default(autoincrement())
  companyName String
  description String
  location String
  avatarUrl String?
  name String?
  phoneNumber String
  address String
  city String
  uf String
  cep String
  cnpj String?
  cpf String?
  userId Int @unique
  user User @relation(fields: [userId], references: [id])

  services Service[]
  appointments Appointment[]
  reviews Review[]
  favoritedBy PetOwner[] @relation("FavoriteProviders")
  images ProviderImage[]
  employees Employee[]
  subscriptions SubscriptionPlan[]
}

model Pet {
  id Int @id @default(autoincrement())
  name String
  breed String
  age Int
  type PetType @default(DOG)
  weight Decimal
  height Decimal
  ownerId Int
  owner PetOwner @relation(fields: [ownerId], references: [id])
}

enum PetType {
  DOG
  CAT
  OTHER
}


model ServiceType {
  id Int @id @default(autoincrement())
  name String @unique

  services Service[]
}

model Service {
  id Int @id @default(autoincrement())
  name String
  description String
  price Decimal
  durationMinutes Int
  providerId Int
  provider PetProvider @relation(fields: [providerId], references: [id])
  serviceTypeId Int
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  appointments Appointment[]
  planServices PlanService[]
  
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment {
  id Int @id @default(autoincrement())
  date            DateTime
  status          AppointmentStatus    @default(PENDING)
  totalPrice      Decimal

  providerId      Int
  provider        PetProvider             @relation(fields: [providerId], references: [id])
  
  petOwnerId      Int
  petOwner        PetOwner             @relation(fields: [petOwnerId], references: [id])
  
  serviceId       Int
  service         Service              @relation(fields: [serviceId], references: [id])
  
  review          Review?
}

model Review {
   id Int @id @default(autoincrement())
  rating          Int            // 1 a 5 estrelas
  comment         String?
  createdAt       DateTime       @default(now())

  appointmentId   Int         @unique
  appointment     Appointment    @relation(fields: [appointmentId], references: [id])
  
  petOwnerId      Int
  petOwner        PetOwner       @relation(fields: [petOwnerId], references: [id])
  
  providerId      Int
  provider        PetProvider       @relation(fields: [providerId], references: [id])
}

model ProviderImage {
  id Int @id @default(autoincrement())
  url String
  altText String?
  isCover Boolean @default(false)
  createdAt DateTime @default(now())
  providerId Int 
  provider PetProvider @relation(fields: [providerId], references: [id])
}

model SubscriptionPlan {
   id Int @id @default(autoincrement())
   name String
   description String
   price Decimal
   durationMonths Int
   recurrence Recurrence
   
   
   providerId Int
   provider PetProvider @relation(fields: [providerId], references: [id])
   planServices PlanService[]
   signatures Signatures[]

}

enum Recurrence {
  MONTHLY
  QUARTERLY
  YEARLY
}

model PlanService {
  
  planId Int
  serviceId Int

  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  @@id([planId, serviceId])
 
}

model Signatures {
  id Int @id @default(autoincrement())  
  ownerId Int
  planId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status StatusSignatures @default(PENDING)
  nextBillingDate DateTime
  paymentGatewayId String
  owner PetOwner @relation(fields: [ownerId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
}

enum StatusSignatures {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  PAST_DUE
  EXPIRED
}




